<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Registration history"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="mb-4"><div class="page-eyebrow">Your activity</div><h1 class="page-title">Registration history.</h1><p class="muted">A simple record of where you have registered.</p></div><div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Venue</th><th>Status</th><th>Registered at</th></tr></thead><tbody><c:forEach var="registration" items="${registrations}"><tr><td><strong><c:out value="${registration.eventTitle}"/></strong></td><td><c:out value="${registration.eventDate}"/></td><td><c:out value="${registration.venue}"/></td><td><span class="status-badge ${registration.status == 'REGISTERED' ? 'badge-soft-success' : 'badge-soft-neutral'}"><c:out value="${registration.status}"/></span></td><td class="small muted"><c:out value="${registration.registeredAt}"/></td></tr></c:forEach><c:if test="${empty registrations}"><tr><td colspan="5" class="text-center muted py-5">No registration history yet.</td></tr></c:if></tbody></table></div></div><%@ include file="../common/dashboard-end.jspf" %>
