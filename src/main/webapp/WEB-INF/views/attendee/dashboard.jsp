<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="My hub"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="hero-panel mb-4"><div class="position-relative" style="z-index:1"><div class="small text-white-50 text-uppercase fw-bold" style="letter-spacing:.12em">Attendee hub</div><h1 class="h3 fw-bold mt-2">Your next experience is closer than it looks.</h1><p class="text-white-50 mb-0">Tickets, registrations, and messages all in one clear place.</p></div></div><div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-label">Upcoming events</span><div class="stat-value mt-3"><c:out value="${fn:length(events)}"/></div><small class="muted">Your registered events</small></div></div><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-label">Purchased tickets</span><div class="stat-value mt-3"><c:out value="${fn:length(orders)}"/></div><small class="muted">Digital confirmations</small></div></div><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-label">Updates</span><div class="stat-value mt-3"><c:out value="${fn:length(messages)}"/></div><small class="muted">From your events</small></div></div><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-label">Registration history</span><div class="stat-value mt-3"><c:out value="${fn:length(registrations)}"/></div><small class="muted">Current and past</small></div></div></div><div class="row g-4"><div class="col-xl-7"><div class="panel"><div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="fw-bold mb-1">Upcoming registered events</h5><p class="muted small mb-0">Your next destinations.</p></div><a class="small" href="${ctx}/attendee/events">Discover more</a></div><c:forEach var="event" items="${events}"><div class="border rounded p-3 mb-2"><div class="d-flex justify-content-between gap-3"><div><strong><c:out value="${event.title}"/></strong><small class="muted d-block"><c:out value="${event.eventDate}"/> · <c:out value="${event.venue}"/></small></div><span class="status-badge badge-soft-success">REGISTERED</span></div></div></c:forEach><c:if test="${empty events}"><div class="empty-state py-5">No upcoming registrations. Find something worth showing up for.</div></c:if></div></div><div class="col-xl-5"><div class="panel h-100"><div class="d-flex justify-content-between"><h5 class="fw-bold">Latest updates</h5><a class="small" href="${ctx}/attendee/updates">View all</a></div><c:forEach var="message" items="${messages}"><div class="border-bottom py-3"><strong class="small"><c:out value="${message.subject}"/></strong><small class="muted d-block"><c:out value="${message.eventTitle}"/></small></div></c:forEach><c:if test="${empty messages}"><div class="empty-state py-5">No updates yet.</div></c:if></div></div></div><%@ include file="../common/dashboard-end.jspf" %>
