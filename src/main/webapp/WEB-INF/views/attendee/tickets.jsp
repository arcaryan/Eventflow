<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="My tickets"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="mb-4"><div class="page-eyebrow">Digital ticket hub</div><h1 class="page-title">Your purchased tickets.</h1><p class="muted">Keep every confirmation close.</p></div><div class="row g-3"><c:forEach var="order" items="${orders}"><div class="col-lg-6"><div class="panel"><div class="d-flex justify-content-between align-items-start"><div><span class="status-badge badge-soft-success"><c:out value="${order.paymentStatus}"/></span><h5 class="fw-bold mt-3 mb-1"><c:out value="${order.eventTitle}"/></h5><div class="muted"><c:out value="${order.ticketName}"/> · Qty <c:out value="${order.quantity}"/></div></div><i class="bi bi-qr-code fs-2 text-primary"></i></div><div class="border-top mt-3 pt-3 d-flex justify-content-between small"><span class="muted">Confirmation</span><strong class="font-monospace"><c:out value="${order.referenceCode}"/></strong></div><div class="d-flex justify-content-between mt-2"><span class="muted small">Total</span><strong>$<c:out value="${order.totalAmount}"/></strong></div></div></div></c:forEach><c:if test="${empty orders}"><div class="col-12"><div class="empty-state panel">No tickets yet. Browse an event and choose your pass.</div></div></c:if></div><%@ include file="../common/dashboard-end.jspf" %>
