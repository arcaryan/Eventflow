<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Profile and preferences"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="mb-4"><div class="page-eyebrow">Personal settings</div><h1 class="page-title">Your profile.</h1><p class="muted">Keep your contact details and notification preference current.</p></div><div class="panel" style="max-width:760px"><div class="d-flex align-items-center gap-3 mb-4"><div class="profile-avatar"><c:out value="${fn:substring(sessionScope.currentUser.name,0,1)}"/></div><div><h5 class="fw-bold mb-1"><c:out value="${sessionScope.currentUser.name}"/></h5><small class="muted"><c:out value="${sessionScope.currentUser.email}"/> · Email stays unique</small></div></div><form method="post"><div class="row g-3"><div class="col-md-6"><label class="form-label">Name</label><input class="form-control" name="name" value="${sessionScope.currentUser.name}" required></div><div class="col-md-6"><label class="form-label">Phone</label><input class="form-control" name="phone" value="${sessionScope.currentUser.phone}"></div><div class="col-12"><label class="form-label">Address / location</label><input class="form-control" name="address" value="${sessionScope.currentUser.address}"></div><div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="notificationPreference" id="notificationPreference" ${sessionScope.currentUser.notificationPreference ? 'checked' : ''}><label class="form-check-label" for="notificationPreference">Show event update notifications in my hub</label></div></div></div><button class="btn btn-primary mt-4" type="submit">Save profile</button></form></div><%@ include file="../common/dashboard-end.jspf" %>
