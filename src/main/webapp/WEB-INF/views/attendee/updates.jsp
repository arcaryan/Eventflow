<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Updates and alerts"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="mb-4"><div class="page-eyebrow">Stay in the loop</div><h1 class="page-title">Updates from your events.</h1><p class="muted">Only messages for events you are registered for appear here.</p></div><div class="panel"><c:forEach var="message" items="${messages}"><article class="border-bottom py-4"><div class="d-flex justify-content-between gap-3"><div><span class="status-badge badge-soft-primary"><c:out value="${message.eventTitle}"/></span><h5 class="fw-bold mt-2"><c:out value="${message.subject}"/></h5></div><small class="muted"><c:out value="${message.createdAt}"/></small></div><p class="muted mb-0"><c:out value="${message.message}"/></p></article></c:forEach><c:if test="${empty messages}"><div class="empty-state">No event updates yet.</div></c:if></div><%@ include file="../common/dashboard-end.jspf" %>
