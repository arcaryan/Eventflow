<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Ticket checkout"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="mb-4"><a class="small" href="${ctx}/events/view?id=${event.id}"><i class="bi bi-arrow-left me-1"></i> Back to event</a><div class="page-eyebrow mt-3">Simulated payment</div><h1 class="page-title">Complete your pass.</h1><p class="muted">This hackathon flow records a simulated paid order; no real payment is processed.</p></div><div class="row g-4"><div class="col-lg-7"><div class="panel"><h5 class="fw-bold mb-4">Checkout details</h5><form method="post"><input type="hidden" name="ticketId" value="${ticket.id}"><div class="border rounded p-3 mb-4"><div class="d-flex justify-content-between"><div><strong><c:out value="${ticket.name}"/></strong><small class="muted d-block"><c:out value="${event.title}"/></small></div><span class="price">$<c:out value="${ticket.price}"/></span></div></div><div class="mb-3"><label class="form-label">Quantity</label><input class="form-control" type="number" name="quantity" value="1" min="1" max="20" required></div><div class="alert alert-info small"><i class="bi bi-info-circle me-1"></i> Stock and totals are validated on the server inside a JDBC transaction.</div><button class="btn btn-primary w-100 py-2" type="submit">Confirm simulated payment</button></form></div></div><div class="col-lg-5"><div class="panel"><div class="page-eyebrow">Order summary</div><h4 class="fw-bold mt-2"><c:out value="${event.title}"/></h4><p class="muted"><c:out value="${event.eventDate}"/> · <c:out value="${event.venue}"/></p><hr><div class="d-flex justify-content-between"><span><c:out value="${ticket.name}"/></span><strong>$<c:out value="${ticket.price}"/></strong></div><div class="d-flex justify-content-between mt-3 fw-bold"><span>Total calculated at checkout</span><span class="text-primary">Server-side</span></div></div></div></div><%@ include file="../common/dashboard-end.jspf" %>
