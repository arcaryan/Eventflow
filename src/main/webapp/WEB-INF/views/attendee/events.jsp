<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Discover events"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="d-flex justify-content-between align-items-end gap-3 mb-4"><div><div class="page-eyebrow">Public catalogue</div><h1 class="page-title">Find your next event.</h1><p class="muted mb-0">Every event here has cleared admin approval.</p></div></div><form class="panel mb-4" method="get"><div class="row g-2"><div class="col-md-7"><label class="form-label">Search</label><input class="form-control" name="search" placeholder="Search by title or topic" value="${param.search}"></div><div class="col-md-3"><label class="form-label">Category</label><input class="form-control" name="category" placeholder="Any category" value="${param.category}"></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Search</button></div></div></form><div class="row g-4"><c:forEach var="event" items="${events}"><div class="col-md-6 col-xl-4"><div class="event-card"><c:choose><c:when test="${not empty event.bannerUrl}"><img class="event-cover" src="${event.bannerUrl}" alt="Event cover"></c:when><c:otherwise><div class="event-cover-placeholder"><i class="bi bi-calendar-event display-5"></i></div></c:otherwise></c:choose><div class="p-3"><span class="status-badge badge-soft-primary"><c:out value="${event.category}"/></span><h5 class="fw-bold mt-3"><c:out value="${event.title}"/></h5><p class="small muted"><c:out value="${event.description}"/></p><div class="small muted"><c:out value="${event.eventDate}"/> · <c:out value="${event.venue}"/></div><div class="d-flex gap-2 mt-3"><a class="btn btn-primary btn-sm" href="${ctx}/events/view?id=${event.id}">View event</a><form method="post" action="${ctx}/attendee/register-event"><input type="hidden" name="id" value="${event.id}"><button class="btn btn-soft btn-sm">Register</button></form></div></div></div></div></c:forEach><c:if test="${empty events}"><div class="col-12"><div class="empty-state panel">No approved events match your search.</div></div></c:if></div><%@ include file="../common/dashboard-end.jspf" %>
