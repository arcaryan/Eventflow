<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Admin overview"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><div class="page-eyebrow">System control</div><h1 class="page-title">Good morning, <c:out value="${sessionScope.currentUser.name}"/>.</h1><p class="muted mb-0">A clear read on the platform, its people, and the next decision.</p></div><a class="btn btn-primary" href="${ctx}/admin/events/pending"><i class="bi bi-shield-check me-1"></i> Review approvals</a></div>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="stat-card"><div class="d-flex justify-content-between"><span class="stat-label">Total users</span><span class="stat-icon"><i class="bi bi-people"></i></span></div><div class="stat-value mt-3"><c:out value="${stats.totalUsers}"/></div><small class="muted"><c:out value="${stats.totalOrganizers}"/> organizers · <c:out value="${stats.totalAttendees}"/> attendees</small></div></div><div class="col-6 col-xl-3"><div class="stat-card"><div class="d-flex justify-content-between"><span class="stat-label">Total events</span><span class="stat-icon"><i class="bi bi-calendar3"></i></span></div><div class="stat-value mt-3"><c:out value="${stats.totalEvents}"/></div><small class="muted"><span class="text-success"><c:out value="${stats.approvedEvents}"/> approved</span></small></div></div><div class="col-6 col-xl-3"><div class="stat-card"><div class="d-flex justify-content-between"><span class="stat-label">Pending approvals</span><span class="stat-icon"><i class="bi bi-hourglass-split"></i></span></div><div class="stat-value mt-3"><c:out value="${stats.pendingEvents}"/></div><small class="muted">Needs a review decision</small></div></div><div class="col-6 col-xl-3"><div class="stat-card"><div class="d-flex justify-content-between"><span class="stat-label">Ticket revenue</span><span class="stat-icon"><i class="bi bi-currency-dollar"></i></span></div><div class="stat-value mt-3">$<c:out value="${stats.totalRevenue}"/></div><small class="muted"><c:out value="${stats.totalTicketsSold}"/> paid tickets sold</small></div></div></div>
<div class="row g-4"><div class="col-xl-7"><div class="panel"><div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="fw-bold mb-1">Pending event approvals</h5><p class="muted small mb-0">Protect the quality of the public catalogue.</p></div><a class="small" href="${ctx}/admin/events/pending">View all</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Organizer</th><th>Date</th><th>Status</th></tr></thead><tbody><c:forEach var="event" items="${pendingEvents}"><tr><td><strong><c:out value="${event.title}"/></strong><small class="muted d-block"><c:out value="${event.category}"/></small></td><td><c:out value="${event.organizerName}"/></td><td><c:out value="${event.eventDate}"/></td><td><span class="status-badge badge-soft-warning">PENDING</span></td></tr></c:forEach><c:if test="${empty pendingEvents}"><tr><td colspan="4" class="text-center muted py-4">No events are waiting for review.</td></tr></c:if></tbody></table></div></div></div><div class="col-xl-5"><div class="panel h-100"><div class="d-flex justify-content-between align-items-center mb-3"><h5 class="fw-bold mb-0">Recent activity</h5><a class="small" href="${ctx}/admin/activity">Open log</a></div><c:forEach var="log" items="${activity}"><div class="d-flex gap-2 mb-3"><span class="activity-dot"></span><div><strong class="small"><c:out value="${log.actionType}"/></strong><p class="small muted mb-0"><c:out value="${log.description}"/></p></div></div></c:forEach><c:if test="${empty activity}"><div class="empty-state py-4">Activity will appear here.</div></c:if></div></div></div>
<div class="panel mt-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="fw-bold mb-1">Platform mix</h5><p class="muted small mb-0">Current events and people at a glance.</p></div></div><div class="chart-box"><canvas id="adminMixChart"></canvas></div></div><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script><script>new Chart(document.getElementById('adminMixChart'),{type:'bar',data:{labels:['Users','Events','Registrations','Tickets sold'],datasets:[{label:'Current total',data:[${stats.totalUsers},${stats.totalEvents},${stats.totalRegistrations},${stats.totalTicketsSold}],backgroundColor:['#4338ca','#0284c7','#059669','#d97706'],borderRadius:5}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{precision:0}}}}});</script><%@ include file="../common/dashboard-end.jspf" %>
