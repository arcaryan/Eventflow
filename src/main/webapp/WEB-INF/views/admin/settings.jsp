<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="System settings"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="mb-4"><div class="page-eyebrow">Platform controls</div><h1 class="page-title">Settings that keep the system practical.</h1><p class="muted">Small controls, visible consequences.</p></div><div class="panel" style="max-width:820px"><form method="post"><div class="row g-3"><div class="col-md-6"><label class="form-label">Platform name</label><input class="form-control" name="platform_name" value="${settings.platform_name}"></div><div class="col-md-6"><label class="form-label">Support email</label><input class="form-control" name="support_email" value="${settings.support_email}"></div><div class="col-md-6"><label class="form-label">Default currency</label><input class="form-control" name="default_currency" value="${settings.default_currency}"></div><div class="col-md-6"><label class="form-label">Maximum tickets per attendee</label><input class="form-control" type="number" min="1" name="max_tickets_per_attendee" value="${settings.max_tickets_per_attendee}"></div><div class="col-md-6"><label class="form-label">Registration enabled</label><select class="form-select" name="registration_enabled"><option value="true" ${settings.registration_enabled == 'true' ? 'selected' : ''}>Enabled</option><option value="false" ${settings.registration_enabled == 'false' ? 'selected' : ''}>Disabled</option></select></div><div class="col-md-6"><label class="form-label">Event approval required</label><select class="form-select" name="event_approval_required"><option value="true" ${settings.event_approval_required == 'true' ? 'selected' : ''}>Required</option><option value="false" ${settings.event_approval_required == 'false' ? 'selected' : ''}>Optional</option></select></div></div><button class="btn btn-primary mt-4" type="submit">Save settings</button></form></div><%@ include file="../common/dashboard-end.jspf" %>
