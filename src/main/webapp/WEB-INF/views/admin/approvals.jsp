<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Event approvals"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="mb-4"><div class="page-eyebrow">Governance queue</div><h1 class="page-title">Approve the next great event.</h1><p class="muted">Only approved events are visible to attendees.</p></div><div class="row g-4"><c:forEach var="event" items="${events}"><div class="col-lg-6"><div class="panel h-100"><div class="d-flex justify-content-between"><span class="status-badge badge-soft-warning">PENDING APPROVAL</span><small class="muted"><c:out value="${event.createdAt}"/></small></div><h4 class="fw-bold mt-3"><c:out value="${event.title}"/></h4><p class="muted"><c:out value="${event.description}"/></p><div class="row g-2 small mb-4"><div class="col-6"><span class="muted d-block">Organizer</span><strong><c:out value="${event.organizerName}"/></strong></div><div class="col-6"><span class="muted d-block">Event date</span><strong><c:out value="${event.eventDate}"/></strong></div><div class="col-6"><span class="muted d-block">Venue</span><strong><c:out value="${event.venue}"/></strong></div><div class="col-6"><span class="muted d-block">Capacity</span><strong><c:out value="${event.capacity}"/></strong></div></div><div class="d-flex gap-2"><form method="post"><input type="hidden" name="id" value="${event.id}"><input type="hidden" name="action" value="approve"><button class="btn btn-primary" type="submit"><i class="bi bi-check2 me-1"></i> Approve</button></form><button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#reject${event.id}"><i class="bi bi-x me-1"></i> Reject</button></div></div></div><div class="modal fade" id="reject${event.id}" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form method="post"><div class="modal-header"><h5 class="modal-title">Reject event</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><input type="hidden" name="id" value="${event.id}"><input type="hidden" name="action" value="reject"><label class="form-label">Reason</label><textarea class="form-control" name="reason" rows="4" required></textarea></div><div class="modal-footer"><button class="btn btn-danger" type="submit">Reject event</button></div></form></div></div></div></c:forEach><c:if test="${empty events}"><div class="col-12"><div class="empty-state panel"><i class="bi bi-check2-circle display-6 d-block mb-2 text-success"></i>Approval queue is clear.</div></div></c:if></div><%@ include file="../common/dashboard-end.jspf" %>
