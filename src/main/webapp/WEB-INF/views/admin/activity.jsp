<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Activity log"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="mb-4"><div class="page-eyebrow">Audit trail</div><h1 class="page-title">System activity.</h1><p class="muted">A readable record of the decisions that matter.</p></div><div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Action</th><th>Actor</th><th>Entity</th><th>Description</th><th>Time</th></tr></thead><tbody><c:forEach var="log" items="${activity}"><tr><td><span class="status-badge badge-soft-primary"><c:out value="${log.actionType}"/></span></td><td><c:out value="${log.actorName != null ? log.actorName : 'System'}"/></td><td class="small muted"><c:out value="${log.entityType}"/> #<c:out value="${log.entityId}"/></td><td><c:out value="${log.description}"/></td><td class="small muted"><c:out value="${log.createdAt}"/></td></tr></c:forEach></tbody></table></div></div><%@ include file="../common/dashboard-end.jspf" %>
