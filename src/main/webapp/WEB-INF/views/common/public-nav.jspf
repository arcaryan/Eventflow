        <a class="navbar-brand d-flex align-items-center gap-2" href="${ctx}/home"><span class="brand-mark">EF</span><span class="brand-word">EventFlow</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav"><span class="navbar-toggler-icon"></span></button>
