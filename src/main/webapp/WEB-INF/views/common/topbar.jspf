<header class="shell-topbar"><div class="d-flex align-items-center gap-2"><button class="btn btn-light mobile-toggle" type="button" data-sidebar-toggle><i class="bi bi-list"></i></button><div class="d-none d-md-block"><span class="muted small">Workspace</span><strong class="d-block"><c:out value="${pageTitle != null ? pageTitle : 'Overview'}"/></strong></div></div><div class="d-flex align-items-center gap-3"><a class="btn btn-soft btn-sm d-none d-sm-inline-flex" href="${ctx}/events"><i class="bi bi-plus-lg me-1"></i> Find an event</a><div class="dropdown"><button class="btn btn-light btn-sm rounded-circle" data-bs-toggle="dropdown"><i class="bi bi-bell"></i></button><ul class="dropdown-menu dropdown-menu-end"><li><span class="dropdown-item-text small muted">No new notifications</span></li></ul></div><div class="d-flex align-items-center gap-2"><div class="profile-avatar" style="width:36px;height:36px;font-size:.85rem"><c:out value="${fn:substring(sessionScope.currentUser.name,0,1)}"/></div><div class="d-none d-lg-block"><strong class="d-block small"><c:out value="${sessionScope.currentUser.name}"/></strong><span class="muted" style="font-size:.7rem"><c:out value="${sessionScope.currentUser.email}"/></span></div></div></div></header>
