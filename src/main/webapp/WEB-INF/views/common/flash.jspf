<c:if test="${not empty flash_success}"><div class="alert alert-success border-0 shadow-sm alert-dismissible fade show" data-auto-dismiss role="alert"><i class="bi bi-check-circle me-2"></i><c:out value="${flash_success}"/><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div></c:if>
<c:if test="${not empty flash_error}"><div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show" data-auto-dismiss role="alert"><i class="bi bi-exclamation-triangle me-2"></i><c:out value="${flash_error}"/><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div></c:if>
<c:if test="${not empty flash_info}"><div class="alert alert-info border-0 shadow-sm alert-dismissible fade show" data-auto-dismiss role="alert"><i class="bi bi-info-circle me-2"></i><c:out value="${flash_info}"/><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div></c:if>
<c:if test="${not empty error}"><div class="alert alert-danger border-0 shadow-sm"><i class="bi bi-exclamation-triangle me-2"></i><c:out value="${error}"/></div></c:if>
