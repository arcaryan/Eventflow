<c:set var="currentUri" value="${requestScope['jakarta.servlet.forward.request_uri']}"/>
<c:if test="${empty currentUri}"><c:set var="currentUri" value="${pageContext.request.servletPath}"/></c:if>
<aside class="shell-sidebar">
    <div class="sidebar-brand d-flex align-items-center gap-2"><span class="brand-mark">EF</span><div><div class="brand-word">EventFlow</div><small class="muted">Operations platform</small></div></div>
    <div class="px-3 flex-grow-1 overflow-auto sidebar-nav">
        <div class="sidebar-label">Workspace</div>
        <c:choose>
            <c:when test="${sessionScope.currentUser.role == 'ADMIN'}"><a class="${fn:endsWith(currentUri, '/admin/dashboard') ? 'active' : ''}" href="${ctx}/admin/dashboard"><i class="bi bi-grid-1x2"></i> Overview</a><a class="${fn:endsWith(currentUri, '/admin/users') ? 'active' : ''}" href="${ctx}/admin/users"><i class="bi bi-people"></i> Users</a><a class="${fn:endsWith(currentUri, '/admin/events/pending') ? 'active' : ''}" href="${ctx}/admin/events/pending"><i class="bi bi-shield-check"></i> Event approvals</a><a class="${fn:endsWith(currentUri, '/admin/activity') ? 'active' : ''}" href="${ctx}/admin/activity"><i class="bi bi-activity"></i> Activity</a><a class="${fn:endsWith(currentUri, '/admin/settings') ? 'active' : ''}" href="${ctx}/admin/settings"><i class="bi bi-sliders"></i> Settings</a></c:when>
            <c:when test="${sessionScope.currentUser.role == 'ORGANIZER'}"><a class="${fn:endsWith(currentUri, '/organizer/dashboard') ? 'active' : ''}" href="${ctx}/organizer/dashboard"><i class="bi bi-grid-1x2"></i> Overview</a><a class="${fn:contains(currentUri, '/organizer/events') ? 'active' : ''}" href="${ctx}/organizer/events"><i class="bi bi-calendar3"></i> My events</a><a class="${fn:contains(currentUri, '/organizer/tickets') ? 'active' : ''}" href="${ctx}/organizer/tickets"><i class="bi bi-ticket-perforated"></i> Ticket types</a><a class="${fn:contains(currentUri, '/organizer/messages') ? 'active' : ''}" href="${ctx}/organizer/messages"><i class="bi bi-megaphone"></i> Broadcasts</a></c:when>
            <c:otherwise><a class="${fn:endsWith(currentUri, '/attendee/dashboard') ? 'active' : ''}" href="${ctx}/attendee/dashboard"><i class="bi bi-grid-1x2"></i> My hub</a><a class="${fn:contains(currentUri, '/attendee/events') ? 'active' : ''}" href="${ctx}/attendee/events"><i class="bi bi-compass"></i> Discover events</a><a class="${fn:contains(currentUri, '/attendee/tickets') ? 'active' : ''}" href="${ctx}/attendee/tickets"><i class="bi bi-ticket-perforated"></i> My tickets</a><a class="${fn:contains(currentUri, '/attendee/history') ? 'active' : ''}" href="${ctx}/attendee/history"><i class="bi bi-clock-history"></i> History</a><a class="${fn:contains(currentUri, '/attendee/updates') ? 'active' : ''}" href="${ctx}/attendee/updates"><i class="bi bi-bell"></i> Updates</a><a class="${fn:contains(currentUri, '/attendee/profile') ? 'active' : ''}" href="${ctx}/attendee/profile"><i class="bi bi-person-circle"></i> Profile</a></c:otherwise>
        </c:choose>
    </div>
    <div class="sidebar-footer"><div class="d-flex align-items-center gap-2 mb-2"><div class="profile-avatar" style="width:34px;height:34px;font-size:.8rem"><c:out value="${fn:substring(sessionScope.currentUser.name,0,1)}"/></div><div class="text-truncate"><strong class="d-block text-truncate"><c:out value="${sessionScope.currentUser.name}"/></strong><small class="muted"><c:out value="${sessionScope.currentUser.role}"/></small></div></div><form method="post" action="${ctx}/logout"><button class="btn btn-light btn-sm w-100 text-start" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button></form></div>
</aside>
