<%@ include file="../common/header.jspf" %>
<%@ include file="../common/public-nav.jspf" %>
<main class="container py-5"><%@ include file="../common/flash.jspf" %><div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><div class="page-eyebrow">Public catalogue</div><h1 class="page-title">Discover approved events.</h1><p class="muted mb-0">Search by title or narrow the view by category.</p></div><c:if test="${not empty sessionScope.currentUser}"><a class="btn btn-soft" href="${ctx}/attendee/dashboard">Open my hub</a></c:if></div><form class="panel mb-4" method="get" action="${ctx}/events"><div class="row g-2"><div class="col-md-7"><label class="form-label">Search</label><input class="form-control" name="search" value="${search}" placeholder="Search events, topics, or places"></div><div class="col-md-3"><label class="form-label">Category</label><input class="form-control" name="category" value="${category}" placeholder="Technology, Design..."></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-search me-1"></i> Search</button></div></div></form><div class="row g-4"><c:forEach var="event" items="${events}"><div class="col-md-6 col-xl-4"><div class="event-card"><c:choose><c:when test="${not empty event.bannerUrl}"><img class="event-cover" src="${event.bannerUrl}" alt="Event cover"></c:when><c:otherwise><div class="event-cover-placeholder"><i class="bi bi-calendar-event display-5"></i></div></c:otherwise></c:choose><div class="p-3"><div class="d-flex justify-content-between align-items-center"><span class="status-badge badge-soft-primary"><c:out value="${event.category}"/></span><small class="muted"><c:out value="${event.eventDate}"/></small></div><h5 class="fw-bold mt-3"><c:out value="${event.title}"/></h5><p class="small muted"><c:out value="${event.description}"/></p><div class="small muted mb-3"><i class="bi bi-person me-1"></i><c:out value="${event.organizerName}"/> · <i class="bi bi-geo-alt me-1"></i><c:out value="${event.venue}"/></div><a class="btn btn-outline-primary btn-sm" href="${ctx}/events/view?id=${event.id}">View details</a></div></div></div></c:forEach><c:if test="${empty events}"><div class="col-12"><div class="empty-state panel"><i class="bi bi-calendar-x display-6 d-block mb-2"></i>No matching approved events found.</div></div></c:if></div></main>
<footer class="container footer">EventFlow · Approved events only.</footer><%@ include file="../common/public-end.jspf" %>
