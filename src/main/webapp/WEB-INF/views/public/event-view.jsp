<%@ include file="../common/header.jspf" %>
<%@ include file="../common/public-nav.jspf" %>
<main class="container py-5"><%@ include file="../common/flash.jspf" %><a href="${ctx}/events" class="small"><i class="bi bi-arrow-left me-1"></i> Back to catalogue</a><div class="row g-4 mt-1"><div class="col-lg-8"><div class="panel p-0 overflow-hidden"><c:choose><c:when test="${not empty event.bannerUrl}"><img class="w-100" style="height:320px;object-fit:cover" src="${event.bannerUrl}" alt="Event cover"></c:when><c:otherwise><div class="event-cover-placeholder" style="height:320px"><i class="bi bi-calendar-event display-1"></i></div></c:otherwise></c:choose><div class="p-4"><div class="d-flex justify-content-between align-items-center"><span class="status-badge badge-soft-primary"><c:out value="${event.category}"/></span><span class="muted small">Approved event</span></div><h1 class="page-title mt-3"><c:out value="${event.title}"/></h1><p class="lead muted"><c:out value="${event.description}"/></p><div class="row g-3 mt-3"><div class="col-sm-4"><div class="muted small">Date</div><strong><c:out value="${event.eventDate}"/></strong></div><div class="col-sm-4"><div class="muted small">Time</div><strong><c:out value="${event.startTime}"/> – <c:out value="${event.endTime}"/></strong></div><div class="col-sm-4"><div class="muted small">Venue</div><strong><c:out value="${event.venue}"/></strong></div></div></div></div></div><div class="col-lg-4"><div class="panel"><div class="page-eyebrow">Tickets</div><h4 class="fw-bold mt-2">Choose your pass</h4><c:forEach var="ticket" items="${tickets}"><div class="border rounded p-3 mt-3"><div class="d-flex justify-content-between"><strong><c:out value="${ticket.name}"/></strong><span class="price">$<c:out value="${ticket.price}"/></span></div><p class="small muted mb-2"><c:out value="${ticket.description}"/></p><div class="d-flex justify-content-between align-items-center"><small class="muted"><c:out value="${ticket.availableQuantity}"/> remaining</small><c:choose><c:when test="${not empty sessionScope.currentUser and sessionScope.currentUser.role == 'ATTENDEE'}"><a class="btn btn-primary btn-sm" href="${ctx}/attendee/purchase?id=${ticket.id}">Purchase</a></c:when><c:when test="${empty sessionScope.currentUser}"><a class="btn btn-outline-primary btn-sm" href="${ctx}/login">Sign in to buy</a></c:when><c:otherwise><span class="small muted">Attendee access only</span></c:otherwise></c:choose></div></div></c:forEach><c:if test="${empty tickets}"><div class="empty-state px-0 py-4">Tickets are not configured yet.</div></c:if><c:if test="${not empty sessionScope.currentUser and sessionScope.currentUser.role == 'ATTENDEE' and not registered}"><form method="post" action="${ctx}/attendee/register-event" class="mt-3"><input type="hidden" name="id" value="${event.id}"><button class="btn btn-soft w-100" type="submit"><i class="bi bi-calendar-check me-1"></i> Register for event</button></form></c:if><c:if test="${registered}"><div class="alert alert-success mt-3 mb-0 small"><i class="bi bi-check-circle me-1"></i>You are registered for this event.</div></c:if></div></div></div></main>
<footer class="container footer">EventFlow · Event details</footer><%@ include file="../common/public-end.jspf" %>
