<%@ include file="../common/header.jspf" %>
<main class="auth-wrap"><div class="container"><div class="auth-card row g-0 mx-auto" style="max-width:1050px"><div class="col-lg-5 auth-aside p-4 p-lg-5 d-flex flex-column justify-content-between"><div><a class="d-flex align-items-center gap-2 text-white text-decoration-none" href="${ctx}/home"><span class="brand-mark bg-white text-primary">EF</span><strong>EventFlow</strong></a><div class="page-eyebrow text-white-50 mt-5">Join the network</div><h1 class="display-6 fw-bold mt-2">Bring the right people into the room.</h1><p class="text-white-50">Create an attendee account to discover events, or an organizer account to start building your own.</p><div class="d-flex gap-3 mt-4 small text-white-50"><span><i class="bi bi-check-circle me-1"></i>Secure sessions</span><span><i class="bi bi-check-circle me-1"></i>Clear roles</span></div></div><div class="small text-white-50">Your password is hashed before it is stored.</div></div><div class="col-lg-7 p-4 p-lg-5"><div class="d-flex justify-content-between align-items-center mb-4"><div><div class="page-eyebrow">Get started</div><h2 class="fw-bold mt-1">Create your account</h2></div><a class="small" href="${ctx}/login">Sign in</a></div><%@ include file="../common/flash.jspf" %><form method="post" action="${ctx}/register"><div class="row g-3"><div class="col-md-6"><label class="form-label">Full name</label><input class="form-control" name="name" required value="${param.name}"></div><div class="col-md-6"><label class="form-label">Phone <span class="muted fw-normal">(optional)</span></label><input class="form-control" name="phone" value="${param.phone}"></div><div class="col-12"><label class="form-label">Email address</label><input class="form-control" type="email" name="email" required value="${param.email}"></div><div class="col-12"><label class="form-label">Password</label><input class="form-control" type="password" name="password" minlength="8" required></div><div class="col-12"><label class="form-label">I am joining as</label><div class="row g-2"><div class="col-6"><input class="btn-check" type="radio" name="role" value="ATTENDEE" id="roleAttendee" checked><label class="btn btn-outline-primary w-100 py-3" for="roleAttendee"><i class="bi bi-ticket-perforated d-block fs-4 mb-1"></i>Attendee</label></div><div class="col-6"><input class="btn-check" type="radio" name="role" value="ORGANIZER" id="roleOrganizer"><label class="btn btn-outline-primary w-100 py-3" for="roleOrganizer"><i class="bi bi-calendar2-plus d-block fs-4 mb-1"></i>Organizer</label></div></div></div></div><button class="btn btn-primary w-100 py-2 mt-4" type="submit">Create account <i class="bi bi-arrow-right ms-1"></i></button></form></div></div></div></main><%@ include file="../common/public-end.jspf" %>
