<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="My events"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><div class="page-eyebrow">Organizer workspace</div><h1 class="page-title">My events.</h1><p class="muted mb-0">Draft, submit, and operate your own events.</p></div><a class="btn btn-primary" href="${ctx}/organizer/events/create"><i class="bi bi-plus-lg me-1"></i> Create event</a></div><div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date & venue</th><th>Status</th><th>Signals</th><th class="text-end">Actions</th></tr></thead><tbody><c:forEach var="event" items="${events}"><tr><td><strong><c:out value="${event.title}"/></strong><small class="muted d-block"><c:out value="${event.category}"/></small></td><td><c:out value="${event.eventDate}"/><small class="muted d-block"><c:out value="${event.venue}"/></small></td><td><span class="status-badge ${event.status == 'APPROVED' ? 'badge-soft-success' : event.status == 'PENDING_APPROVAL' ? 'badge-soft-warning' : event.status == 'REJECTED' ? 'badge-soft-danger' : 'badge-soft-neutral'}"><c:out value="${event.status}"/></span><c:if test="${not empty event.rejectionReason}"><small class="text-danger d-block mt-1"><c:out value="${event.rejectionReason}"/></small></c:if></td><td class="small"><c:out value="${event.registrationCount}"/> registrations<br><span class="muted"><c:out value="${event.ticketsSold}"/> tickets sold</span></td><td class="text-end"><div class="d-flex justify-content-end gap-1 flex-wrap"><a class="btn btn-sm btn-light" href="${ctx}/organizer/events/edit?id=${event.id}">Edit</a><a class="btn btn-sm btn-light" href="${ctx}/organizer/attendees?id=${event.id}">Attendees</a><c:if test="${event.status == 'DRAFT' or event.status == 'REJECTED'}"><form method="post" action="${ctx}/organizer/events/submit"><input type="hidden" name="id" value="${event.id}"><button class="btn btn-sm btn-soft">Submit</button></form></c:if><c:if test="${event.status == 'DRAFT'}"><form method="post" action="${ctx}/organizer/events/delete"><input type="hidden" name="id" value="${event.id}"><button class="btn btn-sm btn-outline-danger" data-confirm="Delete this draft?">Delete</button></form></c:if></div></td></tr></c:forEach><c:if test="${empty events}"><tr><td colspan="5" class="text-center muted py-5">No events yet. Create your first draft.</td></tr></c:if></tbody></table></div></div><%@ include file="../common/dashboard-end.jspf" %>
