<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Event attendees"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="mb-4"><a class="small" href="${ctx}/organizer/events"><i class="bi bi-arrow-left me-1"></i> Back to events</a><div class="page-eyebrow mt-3">Attendee operations</div><h1 class="page-title"><c:out value="${event.title}"/></h1><p class="muted">Registered attendees for this event.</p></div><div class="panel"><div class="d-flex justify-content-between align-items-center mb-3"><h5 class="fw-bold mb-0">Registration roster</h5><span class="status-badge badge-soft-primary"><c:out value="${fn:length(registrations)}"/> registered</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Attendee</th><th>Email</th><th>Status</th><th>Registered</th></tr></thead><tbody><c:forEach var="registration" items="${registrations}"><tr><td><strong><c:out value="${registration.attendeeName}"/></strong></td><td class="muted">Attendee account</td><td><span class="status-badge badge-soft-success"><c:out value="${registration.status}"/></span></td><td class="small muted"><c:out value="${registration.registeredAt}"/></td></tr></c:forEach><c:if test="${empty registrations}"><tr><td colspan="4" class="text-center muted py-5">No registrations yet.</td></tr></c:if></tbody></table></div></div><%@ include file="../common/dashboard-end.jspf" %>
