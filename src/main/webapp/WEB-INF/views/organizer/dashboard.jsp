<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Organizer overview"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="hero-panel mb-4"><div class="d-flex flex-wrap align-items-center justify-content-between gap-3 position-relative" style="z-index:1"><div><div class="small text-white-50 text-uppercase fw-bold" style="letter-spacing:.12em">Organizer studio</div><h1 class="h3 fw-bold mt-2">Build an event people remember.</h1><p class="text-white-50 mb-0">Your events, ticket inventory, and attendee signals in one view.</p></div><a class="btn btn-light" href="${ctx}/organizer/events/create"><i class="bi bi-plus-lg me-1"></i> Create event</a></div></div><div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-label">My events</span><div class="stat-value mt-3"><c:out value="${stats.totalEvents}"/></div><small class="muted"><c:out value="${stats.approvedEvents}"/> approved</small></div></div><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-label">Pending review</span><div class="stat-value mt-3"><c:out value="${stats.pendingEvents}"/></div><small class="muted">Awaiting admin decision</small></div></div><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-label">Tickets sold</span><div class="stat-value mt-3"><c:out value="${stats.totalTicketsSold}"/></div><small class="muted">Across your events</small></div></div><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-label">Revenue</span><div class="stat-value mt-3">$<c:out value="${stats.totalRevenue}"/></div><small class="muted">Paid orders</small></div></div></div><div class="row g-4"><div class="col-xl-8"><div class="panel"><div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="fw-bold mb-1">My events</h5><p class="muted small mb-0">Operational status at a glance.</p></div><a class="small" href="${ctx}/organizer/events">Manage all</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Status</th><th>Registrations</th><th>Revenue</th><th></th></tr></thead><tbody><c:forEach var="event" items="${events}"><tr><td><strong><c:out value="${event.title}"/></strong><small class="d-block muted"><c:out value="${event.eventDate}"/> · <c:out value="${event.venue}"/></small></td><td><span class="status-badge ${event.status == 'APPROVED' ? 'badge-soft-success' : event.status == 'PENDING_APPROVAL' ? 'badge-soft-warning' : event.status == 'REJECTED' ? 'badge-soft-danger' : 'badge-soft-neutral'}"><c:out value="${event.status}"/></span></td><td><c:out value="${event.registrationCount}"/></td><td>$<c:out value="${event.revenue}"/></td><td><a class="btn btn-sm btn-light" href="${ctx}/organizer/tickets">Tickets</a></td></tr></c:forEach></tbody></table></div></div></div><div class="col-xl-4"><div class="panel h-100"><h5 class="fw-bold">Recent broadcasts</h5><c:forEach var="message" items="${messages}"><div class="border-bottom py-3"><strong class="small"><c:out value="${message.subject}"/></strong><small class="muted d-block"><c:out value="${message.eventTitle}"/></small></div></c:forEach><c:if test="${empty messages}"><div class="empty-state py-5">Your attendee messages will appear here.</div></c:if><a href="${ctx}/organizer/messages" class="btn btn-soft w-100 mt-3">Open broadcasts</a></div></div></div>
<div class="panel mt-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="fw-bold mb-1">Portfolio signals</h5><p class="muted small mb-0">A quick read on your current operations.</p></div></div><div class="chart-box"><canvas id="organizerChart"></canvas></div></div><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script><script>new Chart(document.getElementById('organizerChart'),{type:'doughnut',data:{labels:['Approved','Pending','Other'],datasets:[{data:[${stats.approvedEvents},${stats.pendingEvents},${stats.totalEvents - stats.approvedEvents - stats.pendingEvents}],backgroundColor:['#059669','#d97706','#cbd5e1'],borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'}}}});</script><%@ include file="../common/dashboard-end.jspf" %>
