<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="${empty event ? 'Create event' : 'Edit event'}"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="mb-4"><a class="small" href="${ctx}/organizer/events"><i class="bi bi-arrow-left me-1"></i> Back to my events</a><div class="page-eyebrow mt-3">Event workspace</div><h1 class="page-title"><c:out value="${empty event ? 'Create a new event' : 'Edit event details'}"/></h1><p class="muted">Start with the details attendees need to make a confident decision.</p></div><div class="panel" style="max-width:960px"><%@ include file="../common/flash.jspf" %><form method="post" action="${ctx}${empty event ? '/organizer/events/create' : '/organizer/events/edit'}"><c:if test="${not empty event}"><input type="hidden" name="id" value="${event.id}"></c:if><div class="row g-3"><div class="col-md-8"><label class="form-label">Event title</label><input class="form-control" name="title" required value="${event.title}" placeholder="e.g. Global FinTech Summit"></div><div class="col-md-4"><label class="form-label">Category</label><input class="form-control" name="category" value="${event.category}" placeholder="Technology"></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="5" required placeholder="What should attendees know?"><c:out value="${event.description}"/></textarea></div><div class="col-md-4"><label class="form-label">Event date</label><input class="form-control" type="date" name="eventDate" required value="${event.eventDate}"></div><div class="col-md-4"><label class="form-label">Start time</label><input class="form-control" type="time" name="startTime" required value="${event.startTime}"></div><div class="col-md-4"><label class="form-label">End time</label><input class="form-control" type="time" name="endTime" required value="${event.endTime}"></div><div class="col-md-8"><label class="form-label">Venue</label><input class="form-control" name="venue" required value="${event.venue}" placeholder="Venue name and location"></div><div class="col-md-4"><label class="form-label">Capacity</label><input class="form-control" type="number" min="1" name="capacity" required value="${event.capacity}"></div><div class="col-12"><label class="form-label">Banner image URL <span class="muted fw-normal">(optional)</span></label><input class="form-control" type="url" name="bannerUrl" value="${event.bannerUrl}" placeholder="https://..."></div></div><div class="d-flex justify-content-end gap-2 mt-4"><a class="btn btn-light" href="${ctx}/organizer/events">Cancel</a><button class="btn btn-primary" type="submit">Save draft</button></div></form></div><%@ include file="../common/dashboard-end.jspf" %>
