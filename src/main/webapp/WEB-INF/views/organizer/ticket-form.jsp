<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="${empty ticket ? 'Create ticket type' : 'Edit ticket type'}"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="mb-4"><a class="small" href="${ctx}/organizer/tickets"><i class="bi bi-arrow-left me-1"></i> Back to ticket types</a><div class="page-eyebrow mt-3">Inventory studio</div><h1 class="page-title"><c:out value="${empty ticket ? 'Create ticket type' : 'Edit ticket type'}"/></h1></div><div class="panel" style="max-width:760px"><%@ include file="../common/flash.jspf" %><form method="post" action="${ctx}${empty ticket ? '/organizer/tickets/create' : '/organizer/tickets/edit'}"><c:if test="${not empty ticket}"><input type="hidden" name="id" value="${ticket.id}"></c:if><div class="row g-3"><div class="col-12"><label class="form-label">Event</label><select class="form-select" name="eventId" required><c:forEach var="event" items="${events}"><option value="${event.id}" ${ticket.eventId == event.id ? 'selected' : ''}><c:out value="${event.title}"/></option></c:forEach></select></div><div class="col-md-7"><label class="form-label">Ticket name</label><input class="form-control" name="name" required value="${ticket.name}" placeholder="General Admission"></div><div class="col-md-5"><label class="form-label">Price</label><div class="input-group"><span class="input-group-text">$</span><input class="form-control" type="number" step="0.01" min="0" name="price" required value="${ticket.price}"></div></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3"><c:out value="${ticket.description}"/></textarea></div><div class="col-md-4"><label class="form-label">Quantity</label><input class="form-control" type="number" min="1" name="quantity" required value="${ticket.quantity}"></div><div class="col-md-4"><label class="form-label">Sales start</label><input class="form-control" type="datetime-local" name="salesStartAt" value="${ticket.salesStartAt}"></div><div class="col-md-4"><label class="form-label">Sales end</label><input class="form-control" type="datetime-local" name="salesEndAt" value="${ticket.salesEndAt}"></div></div><button class="btn btn-primary mt-4" type="submit">Save ticket type</button></form></div><%@ include file="../common/dashboard-end.jspf" %>
