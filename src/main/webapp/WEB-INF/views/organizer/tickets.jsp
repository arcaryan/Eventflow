<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Ticket types"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><div class="page-eyebrow">Inventory studio</div><h1 class="page-title">Ticket types.</h1><p class="muted mb-0">Keep pricing, availability, and sale windows explicit.</p></div><a class="btn btn-primary" href="${ctx}/organizer/tickets/create"><i class="bi bi-plus-lg me-1"></i> Add ticket type</a></div><div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Ticket</th><th>Event</th><th>Price</th><th>Inventory</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody><c:forEach var="ticket" items="${tickets}"><tr><td><strong><c:out value="${ticket.name}"/></strong><small class="muted d-block"><c:out value="${ticket.description}"/></small></td><td><c:out value="${ticket.eventTitle}"/></td><td class="fw-bold">$<c:out value="${ticket.price}"/></td><td><c:out value="${ticket.soldQuantity}"/> / <c:out value="${ticket.quantity}"/><div class="progress mt-1" style="height:5px"><div class="progress-bar bg-primary" style="width:${ticket.quantity == 0 ? 0 : ticket.soldQuantity * 100 / ticket.quantity}%"></div></div></td><td><span class="status-badge ${ticket.status == 'ACTIVE' ? 'badge-soft-success' : 'badge-soft-neutral'}"><c:out value="${ticket.status}"/></span></td><td class="text-end"><a class="btn btn-sm btn-light" href="${ctx}/organizer/tickets/edit?id=${ticket.id}">Edit</a><form method="post" action="${ctx}/organizer/tickets/delete" class="d-inline"><input type="hidden" name="id" value="${ticket.id}"><button class="btn btn-sm btn-outline-danger" data-confirm="Delete this ticket type?">Delete</button></form></td></tr></c:forEach><c:if test="${empty tickets}"><tr><td colspan="6" class="text-center muted py-5">No ticket types yet.</td></tr></c:if></tbody></table></div></div><%@ include file="../common/dashboard-end.jspf" %>
