<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Broadcasts"/><%@ include file="../common/dashboard-start.jspf" %>
<div class="mb-4"><div class="page-eyebrow">Attendee communication</div><h1 class="page-title">Send a useful update.</h1><p class="muted">Messages are stored and shown to registered attendees for the selected event.</p></div><div class="row g-4"><div class="col-lg-5"><div class="panel"><h5 class="fw-bold">New broadcast</h5><form method="post" class="mt-3"><div class="mb-3"><label class="form-label">Event</label><select class="form-select" name="eventId" required><c:forEach var="event" items="${events}"><option value="${event.id}"><c:out value="${event.title}"/></option></c:forEach></select></div><div class="mb-3"><label class="form-label">Subject</label><input class="form-control" name="subject" required placeholder="Schedule update"></div><div class="mb-3"><label class="form-label">Message</label><textarea class="form-control" name="message" rows="6" required placeholder="Share the important details..."></textarea></div><button class="btn btn-primary w-100" type="submit"><i class="bi bi-send me-1"></i> Send update</button></form></div></div><div class="col-lg-7"><div class="panel"><h5 class="fw-bold mb-3">Sent updates</h5><c:forEach var="message" items="${messages}"><div class="border-bottom py-3"><div class="d-flex justify-content-between"><strong><c:out value="${message.subject}"/></strong><small class="muted"><c:out value="${message.createdAt}"/></small></div><small class="status-badge badge-soft-primary mt-2"><c:out value="${message.eventTitle}"/></small><p class="muted small mt-2 mb-0"><c:out value="${message.message}"/></p></div></c:forEach><c:if test="${empty messages}"><div class="empty-state py-5">No updates sent yet.</div></c:if></div></div></div><%@ include file="../common/dashboard-end.jspf" %>
